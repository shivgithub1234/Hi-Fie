# Set these in Vercel Project Settings > Environment Variables for Production.
# This is a template. Never put actual credentials in this file.
NEXTAUTH_URL=https://your-project.vercel.app
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CRON_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=verify-full
# Optional direct URL for migrations. It must target the same database and branch.
DATABASE_URL_UNPOOLED=
PRISMA_MIGRATION_URL=
