NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
CRON_SECRET=replace-with-another-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Optional: direct connection for migrations (Neon provides DATABASE_URL_UNPOOLED).
DATABASE_URL_UNPOOLED=
# Optional: an accessible test database. Tests create and remove only their own temporary schema.
TEST_DATABASE_URL=
# Optional override used by the Prisma migration CLI (otherwise the direct URL is preferred).
PRISMA_MIGRATION_URL=
